# ~/.ssh/rc - run by sshd with /bin/sh at the start of every session,
# right before the user's shell or command (see sshd(8), SSHRC).
# Must stay POSIX sh, never block and never write to stdout: for non-tty
# sessions (scp, rsync, git) stdout is the data stream.

# Because this file exists, sshd no longer adds X11 forwarding cookies
# itself, so do it here. stdin only carries the cookie if X11 forwarding
# is active; otherwise it is the session's input and must not be read.
if [ -n "$DISPLAY" ] && command -v xauth >/dev/null 2>&1; then
  if read -r proto cookie; then
    case "$DISPLAY" in
      localhost:*) echo add "unix:${DISPLAY#localhost:}" "$proto" "$cookie" ;;
      *)           echo add "$DISPLAY" "$proto" "$cookie" ;;
    esac | xauth -q - >/dev/null 2>&1
  fi
fi

# Don't suspend while an ssh session is open (e.g. after WoL with nobody
# logged in locally). $PPID is the process that becomes the session's
# shell/command; the inhibitor lock is held until it exits.
# Silently skipped where there is no systemd (containers, minimal VPS).
if command -v systemd-inhibit >/dev/null 2>&1 \
   && [ -d /run/systemd/system ] && [ -d "/proc/$PPID" ]; then
  systemd-inhibit --what=sleep --mode=block --who="ssh ${USER:-$LOGNAME}" \
    --why="SSH session from ${SSH_CLIENT%% *}" \
    sh -c 'while [ -d "/proc/$1" ]; do sleep 10; done' nosleep "$PPID" \
    </dev/null >/dev/null 2>&1 &
fi

# Never let a failure here affect the session.
true
